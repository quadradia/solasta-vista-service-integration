#include <windows.h>

/* Event Log message table (messages.rc and MSG00409.bin are generated by mc.exe). */
#include "messages.rc"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Solasta"
            VALUE "FileDescription", "Solasta Vista Item Sync service"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "vista-sync"
            VALUE "OriginalFilename", "vista-sync.exe"
            VALUE "ProductName", "Solasta Vista Item Sync"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
